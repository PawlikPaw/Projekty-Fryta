{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [
    "-fdiagnostics-color=always",
    "-g",
    "${fileDirname}/*.cpp",
    "-o",
    "${fileDirname}/${fileBasenameNoExtension}"
    ],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "/home/admin/Projekty/Projekty-Fryta/Projekt",
      "program": "/home/admin/Projekty/Projekty-Fryta/Projekt/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}